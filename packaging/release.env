# shellcheck shell=bash disable=SC2034,SC2154
# Sourced by PortableKit's Linux release scripts.
case "${PORTABLEKIT_GAME_EDITION:-po}" in
    po)
        RELEASE_NAME=PortableOpsNative
        RELEASE_SLUG=portable-ops-native
        RELEASE_APP_ID=io.github.zexk.PortableOpsNative
        ;;
    pop)
        RELEASE_NAME=PortableOpsPlusNative
        RELEASE_SLUG=portable-ops-plus-native
        RELEASE_APP_ID=io.github.zexk.PortableOpsPlusNative
        RELEASE_EXTRA_PROGRAMS=(mpo-server)
        ;;
    *) echo 'Release edition must be po or pop' >&2; exit 2 ;;
esac
RELEASE_TARGET="$RELEASE_NAME"
RELEASE_GENERATED_DIR="profiles/${PORTABLEKIT_GAME_EDITION:-po}/generated"
RELEASE_CMAKE_ARGS=("-DMGS_EDITION=${PORTABLEKIT_GAME_EDITION:-po}")
[[ -d "$repo_dir/profiles/${PORTABLEKIT_GAME_EDITION:-po}/overlays" ]] || {
    echo 'Generate the game modules before packaging' >&2; exit 1;
}
RELEASE_CCACHE_MAXSIZE=2G
RELEASE_OVERLAYS=$(find "$repo_dir/profiles/${PORTABLEKIT_GAME_EDITION:-po}/overlays" -name meta.txt | wc -l)
[[ "$RELEASE_OVERLAYS" -gt 0 ]] || { echo 'Generate the game modules before packaging' >&2; exit 1; }

RELEASE_AUDIT=scripts/release_audit.py
